# =============================================================================
# Agent 驱动的自动化投研系统 —— 环境变量样例
#
# 用法：复制为 .env 后按需修改；另有 .env.local（优先级更高、不进版本库）可用于本地覆盖。
# 键名与 app/config.py 的字段一一对应（pydantic-settings 自动映射，大小写不敏感）。
# =============================================================================

# ===== 应用 =====
APP_NAME=investment-research-agent
DEBUG=false

# ===== LLM：DeepSeek（Flash 默认档 / Pro 高质量档，需求 3.2）=====
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash          # 默认档：信息搜集 / 财报分析
DEEPSEEK_MODEL_PRO=deepseek-v4-pro        # 高质量档：报告撰写（需求 3.4）
REPORT_WRITER_LLM_TIER=pro                # 报告撰写用哪一档（成本敏感可改 flash）
REPORT_MAX_TOKENS=8192                    # 报告正文输出上限（含 reasoning 预算）
REPORT_LLM_TIMEOUT=240                    # 报告生成单次调用超时（秒）
LLM_TEMPERATURE=0.1
LLM_TIMEOUT=90
LLM_MAX_TOKENS=4096                       # 报告生成需要长输出
LLM_MAX_RETRIES=1
LLM_CIRCUIT_THRESHOLD=3                   # 连续失败多少次打开熔断
LLM_CIRCUIT_COOLDOWN=30

# ===== Celery 后台任务队列（需求 3.1 / 3.6 / N7）=====
CELERY_BROKER_URL=redis://localhost:6380/1        # broker 单独用 db1，与缓存/限流分库
CELERY_RESULT_BACKEND=redis://localhost:6380/2    # 结果后端用 db2
CELERY_QUEUE=research
CELERY_WORKER_CONCURRENCY=3                       # 需求 N7：最多 3 个任务同时运行
CELERY_TASK_TIME_LIMIT=900                        # 需求 3.6：硬超时 15 分钟 → 标记 failed
CELERY_TASK_SOFT_TIME_LIMIT=840                   # 软超时提前 60s，便于写日志/清理
CELERY_TASK_MAX_RETRIES=3                         # 需求 F6：失败自动重试
CELERY_RETRY_BACKOFF=2
CELERY_RETRY_BACKOFF_MAX=60
CELERY_RESULT_EXPIRES=86400
CELERY_TASK_ACKS_LATE=true                        # worker 崩溃时任务重回队列
CELERY_WORKER_PREFETCH_MULTIPLIER=1               # 长任务：一次只预取一个

# ===== 任务编排与超时保护（需求 3.6 / 3.7）=====
TASK_TIMEOUT_SECONDS=900
TASK_ESTIMATED_SECONDS=480                # 创建任务返回的预估耗时（8 分钟）
MAX_CONCURRENT_TASKS=3                    # 需求 N7：应用层并发闸门
STEP_MAX_RETRIES=2                        # 需求 3.7：输出校验失败最多重试 2 次
CONTINUE_ON_STEP_FAILURE=true             # 需求 3.7：该步仍失败则跳过，后续 Agent 用已有数据继续

# ===== 数据源：SEC EDGAR（10-K 年报，需求 3.3）=====
SEC_USER_AGENT=investment-research-agent/0.1 (contact: your-email@example.com)   # SEC 强制要求含联系方式，否则 403
SEC_EDGAR_BASE_URL=https://data.sec.gov
SEC_ARCHIVES_BASE_URL=https://www.sec.gov
SEC_API_KEY=                              # 可选：sec-api.io 商业网关（留空则直连 EDGAR）
SEC_API_BASE_URL=https://api.sec-api.io
SEC_FILING_TYPE=10-K
SEC_REQUEST_INTERVAL=0.15                 # SEC 官方限速 10 req/s，本地留余量
SEC_TIMEOUT=30
SEC_MAX_RETRIES=3
SEC_FILINGS_DIR=./data/filings            # 年报文件落盘目录

# ===== PDF 解析：MinerU（首选）+ PyPDF2/pdfplumber（降级，需求 3.9）=====
MINERU_ENABLED=true
MINERU_BACKEND=pipeline                   # pipeline（CPU 可用）/ vlm-transformers / vlm-sglang-client
MINERU_COMMAND=mineru                     # CLI 入口；旧版 magic-pdf 可在此覆盖
MINERU_API_URL=                           # 走 HTTP 服务时填写，留空则调用本地 CLI
MINERU_OUTPUT_DIR=./data/parsed           # 结构化 JSON + 表格/图片产物目录
MINERU_LANG=en
MINERU_TIMEOUT=300
PDF_FALLBACK_ENABLED=true

# ===== 备用数据源：Yahoo Finance（需求 3.3 / 3.9）=====
YAHOO_FINANCE_ENABLED=true
YAHOO_FINANCE_TIMEOUT=15
YAHOO_FINANCE_MAX_RETRIES=2
YAHOO_FINANCE_CACHE_TTL_SECONDS=3600      # 股价/市值短缓存

# ===== 工具重试与降级（tenacity，需求 3.6 / 3.9）=====
TOOL_TIMEOUT=60
TOOL_MAX_RETRIES=3                        # stop_after_attempt(3)
TOOL_RETRY_MIN_WAIT=2                     # wait_exponential(multiplier=1, min=2, max=10)
TOOL_RETRY_MAX_WAIT=10

# ===== 缓存与产出（需求 N2：财报数据走缓存时 <5 分钟）=====
CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600                    # 通用缓存（搜索/新闻等易变数据）
FINANCIALS_CACHE_TTL_SECONDS=86400        # 解析出的财务数据 24h
FILINGS_CACHE_TTL_SECONDS=604800          # 已下载年报 7 天
REPORT_OUTPUT_DIR=./data/reports
REPORT_FORMAT=markdown

# ===== PostgreSQL（任务状态 / 中间产出 / 报告，需求 3.8）=====
PG_HOST=localhost
# 端口冲突处理：项目一（RAG-Agent）仍在运行并占用 5432/6379，故本项目统一改用
#   5433（PostgreSQL）与 6380（Redis）；容器内端口不变。
#   compose 的宿主端口映射与应用连接都由这里的值驱动（另有 .env.local 覆盖层）。
PG_PORT=5433
PG_USER=research
PG_PASSWORD=researchpass
PG_DATABASE=research
PG_POOL_MIN=2
PG_POOL_MAX=20

# ===== Redis（限流 + 通用缓存）=====
# 三个 Redis 库分工，避免 key 冲突：db0 限流/缓存、db1 Celery broker、db2 Celery 结果
# 端口统一用 6380（项目一的 rag-redis 占用 6379）；下面三处 URL 的端口需保持一致
REDIS_URL=redis://localhost:6380/0

# ===== 基础设施端口映射（docker-compose.infra.yml 读取；容器内端口不变）=====
REDIS_PORT=6380

# ===== 认证（需求 N6：API 需鉴权）=====
API_TOKEN=dev-token-change-me
ADMIN_TOKEN=admin-token-change-me         # 审计/管理只读接口专用
AUTH_DEBUG_LOG=false                      # 打印明文 Authorization 头（仅排查用，生产必须 false）

# ===== 限流（需求 N6 / 3.10）=====
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60                  # 单身份每分钟请求数（查询类接口）
RATE_LIMIT_BURST=20
TASK_CREATE_PER_MINUTE=1                  # 需求 3.10：每个 token 每分钟最多触发 1 个新任务
TASK_CREATE_BURST=1
RATE_LIMIT_GLOBAL_PER_MINUTE=0            # 全局每分钟上限（0=关闭）
RATE_LIMIT_GLOBAL_BURST=0

# ===== 审计与人工干预（需求 F5）=====
AUDIT_ENABLED=true                        # 每步中间产出落库，支持审计
HUMAN_INTERVENTION_ENABLED=true           # 支持人工在步骤间介入修正后继续

# ===== 可观测性（需求 N4）=====
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=investment-research-agent
PROMETHEUS_URL=http://localhost:9090
